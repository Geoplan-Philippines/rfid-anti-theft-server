# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV=production
PORT=8000

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL=postgresql://postgres:123@localhost:5432/nestjs_postgres_passport?schema=public

# --------------------------------------------
# REQUIRED: AUTH SETTINGS
# --------------------------------------------
JWT_SECRET=replace-with-32-plus-character-secret

# --------------------------------------------
# OPTIONAL: SECURITY HEADER SETTINGS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --------------------------------------------
# OPTIONAL: ALARM SETTINGS
# --------------------------------------------
# Seconds a tag stays quiet after an alarm. Whole number from 1 to 86400.
ALARM_COOLDOWN_SECONDS=30

# --------------------------------------------
# OPTIONAL: CCTV SNAPSHOT SETTINGS
# --------------------------------------------
# CCTV_SNAPSHOT_URL=
# CCTV_USERNAME=
# CCTV_PASSWORD=