generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                    @id @default(uuid())
  firstName                     String?                   @map("first_name")
  lastName                      String?                   @map("last_name")
  email                         String                    @unique
  password                      String
  role                          RoleEnum                  @default(ADMIN)
  isArchived                    Boolean                   @default(false) @map("is_archived")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  
  @@map("users")
}

model KnownEpc {
  id                            String                    @id @default(uuid())
  epc                           String                    @unique
  label                         String?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("known_epcs")
}

model AlarmEvent {
  id                            String                    @id @default(uuid())
  epc                           String
  readerName                    String?                   @map("reader_name")
  scannedAt                     DateTime?                 @map("scanned_at")

  createdAt                     DateTime                  @default(now()) @map("created_at")

  @@index([epc])
  @@index([scannedAt])
  @@map("alarm_events")
}

enum RoleEnum {
  SUPER_ADMIN
  ADMIN
  USER
}
