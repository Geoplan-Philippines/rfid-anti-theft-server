generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                    @id @default(uuid())
  firstName                     String?                   @map("first_name")
  lastName                      String?                   @map("last_name")
  email                         String                    @unique
  password                      String
  role                          RoleEnum                  @default(ADMIN)
  isArchived                    Boolean                   @default(false) @map("is_archived")

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  
  @@map("users")
}

model KnownEpc {
  id                            String                    @id @default(uuid())
  epc                           String                    @unique
  label                         String?

  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")

  @@map("known_epcs")
}

model UnsellEvent {
  id                            String                    @id @default(uuid())
  actorUserId                   String                    @map("actor_user_id")
  actorEmail                    String                    @map("actor_email")
  reason                        String?
  requestedEpcs                 String[]                  @map("requested_epcs")
  unsoldEpcs                    String[]                  @map("unsold_epcs")
  alreadyUnsoldEpcs             String[]                  @map("already_unsold_epcs")
  duplicateEpcsIgnored          Int                       @map("duplicate_epcs_ignored")

  createdAt                     DateTime                  @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("unsell_events")
}

model AlarmEvent {
  id                            String                    @id @default(uuid())
  epc                           String
  readerName                    String?                   @map("reader_name")
  scannedAt                     DateTime?                 @map("scanned_at")
  captureImageUrl               String?                   @map("capture_image_url")

  createdAt                     DateTime                  @default(now()) @map("created_at")

  @@index([epc])
  @@index([scannedAt])
  @@map("alarm_events")
}

// A retry must return the original alreadySoldEpcs and duplicateEpcsIgnored. After commit those EPCs are on known_epcs, so recomputing would change the result.
model Transaction {
  id                            String                    @id @default(uuid())
  clientTransactionId           String                    @unique @map("client_transaction_id")
  storeCode                     String                    @map("store_code")
  deviceId                      String                    @map("device_id")
  cashierName                   String?                   @map("cashier_name")
  startedAt                     DateTime                  @map("started_at")
  endedAt                       DateTime                  @map("ended_at")
  itemCount                     Int                       @map("item_count")
  duplicateEpcsIgnored          Int                       @map("duplicate_epcs_ignored")
  alreadySoldEpcs               String[]                  @map("already_sold_epcs")

  createdAt                     DateTime                  @default(now()) @map("created_at")

  tags                          TransactionTag[]

  @@index([startedAt])
  @@index([storeCode])
  @@map("transactions")
}

model TransactionTag {
  id                            String                    @id @default(uuid())
  transactionId                 String                    @map("transaction_id")
  epc                           String
  scannedAt                     DateTime                  @map("scanned_at")

  transaction                   Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, epc])
  @@index([epc])
  @@map("transaction_tags")
}

enum RoleEnum {
  SUPER_ADMIN
  ADMIN
  USER
}
